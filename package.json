{
  "name": "portfolio-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "typegen": "next typegen",
    "typecheck": "next typegen && node node_modules/@typescript/native/lib/tsc.js --noEmit",
    "test": "jest",
    "prepare": "husky",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "check": "npm run typegen && npm run format:check && npm run lint && node node_modules/@typescript/native/lib/tsc.js --noEmit && npm test"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "*.{md,css,json,yml,yaml}": [
      "oxfmt"
    ]
  },
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 16.4"
  ],
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@tailwindcss/postcss": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.1.0-beta",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "eslint-plugin-jest-dom": "^5.10.2",
    "eslint-plugin-testing-library": "^7.16.2",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "unrs-resolver": false
  }
}
