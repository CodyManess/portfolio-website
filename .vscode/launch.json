{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Next.js: Dev Server & Browser",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm.cmd run dev",
      "serverReadyAction": {
        "pattern": "- Local:\\s+(https?://.+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Next.js: Debug Client-side (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000",
      "webRoot": "${workspaceFolder}"
    }
  ]
}
